<Window x:Class="ePrescriptions.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ePrescriptions.App.ViewModels"
        xmlns:views="clr-namespace:ePrescriptions.App.Views"
        mc:Ignorable="d"
        Title="e_prescriptions - النظام المتكامل لإدارة الصيدليات والوصفات الطبية"
        Icon="pack://application:,,,/Resources/app.ico"
        Height="800" Width="1366"
        MinHeight="560" MinWidth="900"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource AppBackgroundGradient}">

    <!-- تعيين DataTemplates لربط كل ViewModel بـ View الخاصة به -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate DataType="{x:Type vm:SalesViewModel}">
            <views:SalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchasesViewModel}">
            <views:PurchasesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SupplierReturnsViewModel}">
            <views:SupplierReturnsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchaseOrdersViewModel}">
            <views:PurchaseOrdersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StocktakeViewModel}">
            <views:StocktakeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OpeningStockViewModel}">
            <views:OpeningStockView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PriceListImportViewModel}">
            <views:PriceListImportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FinanceViewModel}">
            <views:FinanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StaffViewModel}">
            <views:StaffView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ZakatViewModel}">
            <views:ZakatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HelpViewModel}">
            <views:HelpView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OwnerLogViewModel}">
            <views:OwnerLogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StaffAuditLogViewModel}">
            <views:StaffAuditLogView />
        </DataTemplate>
    </Window.Resources>

    <!-- اختصارات لوحة المفاتيح العامة (F1..F10, Delete) -->
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding CurrentView.NewInvoiceCommand}" />
        <KeyBinding Key="F2" Command="{Binding CurrentView.SaveInvoiceCommand}" />
        <KeyBinding Key="F3" Command="{Binding CurrentView.PrintInvoiceCommand}" />
        <KeyBinding Key="F4" Command="{Binding CurrentView.OpenItemSearchCommand}" />
        <KeyBinding Key="Delete" Command="{Binding CurrentView.RemoveSelectedItemCommand}" />
        <KeyBinding Key="F8" Command="{Binding CurrentView.SuspendInvoiceCommand}" />
        <KeyBinding Key="F9" Command="{Binding CurrentView.ToggleReturnModeCommand}" />
        <KeyBinding Key="F10" Command="{Binding CurrentView.OpenCashDrawerCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- الشريط العلوي الرئيسي مع الساعة الحية وحالة المستخدم -->
            <RowDefinition Height="46" />
            <!-- شريط تنبيه النسخ الاحتياطي (يظهر عند وجود مشكلة فقط) -->
            <RowDefinition Height="Auto" />
            <!-- المحتوى والشريط الجانبي -->
            <RowDefinition Height="*" />
            <!-- الفوتر: تحت خالص -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1) الشريط العلوي العام للتطبيق -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" BorderBrush="{StaticResource BrandStripeGradient}" BorderThickness="0,0,0,2.5" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- اسم وشعار الصيدلية والنظام -->
                    <ColumnDefinition Width="Auto" />
                    <!-- شريط التاريخ الهجري والميلادي والوقت المباشر (يتحدث كل ثانية) -->
                    <ColumnDefinition Width="*" />
                    <!-- بيانات المستخدم والوردية وقفل الشاشة -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="7" Width="30" Height="30" Margin="0,0,10,0">
                        <Path Data="{StaticResource IconCapsule}" Fill="#0083CB" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="e_prescriptions" Foreground="White" FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="نظام إدارة الصيدليات والوصفات الطبية" Foreground="#DCF1FB" FontSize="10" />
                    </StackPanel>
                </StackPanel>

                <!-- شريط الوقت المباشر مع تقويم أم القرى -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="#26FFFFFF" CornerRadius="6" Padding="12,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LiveDateTimeString}" Foreground="White" FontWeight="SemiBold" FontSize="11.5" />
                    </StackPanel>
                </Border>

                <!-- المستخدم والوردية الحالية -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ShiftStatusDisplay}" Foreground="#32992B" FontWeight="Bold" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Background="#D3277B" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                        <TextBlock Text="{Binding CurrentUserDisplay}" Foreground="White" FontWeight="Bold" FontSize="12" />
                    </Border>

                    <!-- زر قفل الشاشة السريع وزر تسجيل الخروج -->
                    <Button Command="{Binding LockScreenCommand}" Background="#26FFFFFF" BorderThickness="0" Cursor="Hand" Padding="10,6" Margin="0,0,6,0">
                        <TextBlock Text="قفل الشاشة" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                    </Button>
                    <Button Command="{Binding LogoutCommand}" Background="#FFE4EE" BorderThickness="0" Cursor="Hand" Padding="10,6">
                        <TextBlock Text="خروج" Foreground="#A2165F" FontSize="11" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1.5) خطوة 41: تنبيه النسخ الاحتياطي للمدير/المالك -->
        <Border Grid.Row="1" Background="#7F1D1D" Padding="16,6" Visibility="{Binding HasBackupAlert, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding BackupAlertText}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Command="{Binding OpenBackupSettingsCommand}" Content="فتح إعدادات النسخ" Margin="12,0,0,0" Padding="12,2" />
            </Grid>
        </Border>

        <!-- 2) المحتوى الرئيسي: شريط جانبي يمين + شاشة العرض يسار -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <!-- قائمة التنقل داخل الهيدر -->
                <RowDefinition Height="Auto" />
                <!-- شريط الشاشات المنفصلة السريع (Multi-Window) -->
                <RowDefinition Height="Auto" />
                <!-- الشاشة المعروضة حالياً -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- الشريط الجانبي للوحدات -->
            <Border Grid.Row="0" Background="White" BorderBrush="#D5E4EE" BorderThickness="0,0,0,1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
                    <WrapPanel Margin="6,4,6,4">
                        <!-- نقطة البيع (المبيعات) - الافتراضية -->
                        <RadioButton Command="{Binding NavigateSalesCommand}" Style="{StaticResource SidebarNavButton}" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSales}" Fill="#0083CB" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="المبيعات (F1)" FontWeight="Bold" />
                            </StackPanel>
                        </RadioButton>

                        <!-- إدارة المخزون والأدوية -->
                        <RadioButton Command="{Binding NavigateInventoryCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessInventory, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconInventory}" Fill="#D3277B" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="المخزون والأدوية" />
                            </StackPanel>
                        </RadioButton>

                        <!-- المشتريات والموردون -->
                        <RadioButton Command="{Binding NavigatePurchasesCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessPurchases, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPurchases}" Fill="#32992B" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="المشتريات والموردون" />
                            </StackPanel>
                        </RadioButton>

                        <!-- أوامر الشراء -->
                        <RadioButton Command="{Binding NavigatePurchaseOrdersCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessPurchases, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPurchases}" Fill="#0155A5" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="أوامر الشراء" />
                            </StackPanel>
                        </RadioButton>

                        <!-- مرتجع / إتلاف المنتهي -->
                        <RadioButton Command="{Binding NavigateSupplierReturnsCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessPurchases, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPurchases}" Fill="#E7387D" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="مرتجع / إتلاف المنتهي" />
                            </StackPanel>
                        </RadioButton>

                        <!-- جرد بالباركود -->
                        <RadioButton Command="{Binding NavigateStocktakeCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessInventory, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconInventory}" Fill="#32992B" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="الجرد بالباركود" />
                            </StackPanel>
                        </RadioButton>

                        <!-- رصيد أول المدة (بضاعة أول المدة) -->
                        <RadioButton Command="{Binding NavigateOpeningStockCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessOpeningStock, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconOpeningStock}" Fill="#10B981" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="رصيد أول المدة" />
                            </StackPanel>
                        </RadioButton>

                        <!-- تحديث الأسعار من Excel (Admin/Owner) -->
                        <RadioButton Command="{Binding NavigatePriceListImportCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessPriceListImport, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPurchases}" Fill="#0083CB" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="تحديث الأسعار (Excel)" />
                            </StackPanel>
                        </RadioButton>

                        <!-- العملاء والآجل -->
                        <RadioButton Command="{Binding NavigateCustomersCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessCustomers, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCustomers}" Fill="#E7387D" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="حسابات العملاء" />
                            </StackPanel>
                        </RadioButton>

                        <!-- المالية والمصروفات -->
                        <RadioButton Command="{Binding NavigateFinanceCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessFinance, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFinance}" Fill="#7BB82D" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="الحسابات والمالية" />
                            </StackPanel>
                        </RadioButton>

                        <!-- سجل نشاطي: يظهر فقط لحساب صاحب الصيدلية -->
                        <RadioButton Command="{Binding NavigateOwnerLogCommand}" Style="{StaticResource SidebarNavButton}"
                                     Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconReports}" Fill="#A2165F" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="سجل نشاطي" />
                            </StackPanel>
                        </RadioButton>

                        <!-- سجل نشاط الموظفين: يظهر للمدير وصاحب الصيدلية فقط (لا يحتوي تعديلات Owner) -->
                        <RadioButton Command="{Binding NavigateStaffAuditLogCommand}" Style="{StaticResource SidebarNavButton}"
                                     Visibility="{Binding IsAdminOrOwner, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconReports}" Fill="#02ABE1" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="سجل نشاط الموظفين" />
                            </StackPanel>
                        </RadioButton>

                        <!-- الموظفون والورديات -->
                        <RadioButton Command="{Binding NavigateStaffCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessStaff, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconStaff}" Fill="#0155A5" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="الموظفون والورديات" />
                            </StackPanel>
                        </RadioButton>

                        <!-- حساب الزكاة الشرعية -->
                        <RadioButton Command="{Binding NavigateZakatCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessZakat, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconZakat}" Fill="#7BB82D" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="حاسبة الزكاة" />
                            </StackPanel>
                        </RadioButton>

                        <!-- التقارير الشاملة -->
                        <RadioButton Command="{Binding NavigateReportsCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessReports, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconReports}" Fill="#0155A5" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="التقارير والإحصاءات" />
                            </StackPanel>
                        </RadioButton>

                        <Border Width="1" Height="24" Background="#D5E4EE" Margin="8,0" />

                        <!-- الإعدادات والطابعات -->
                        <RadioButton Command="{Binding NavigateSettingsCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding CanAccessSettings, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSettings}" Fill="#5B7389" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="إعدادات النظام" />
                            </StackPanel>
                        </RadioButton>

                        <!-- شاشة الاختصارات والمساعدة -->
                        <RadioButton Command="{Binding NavigateHelpCommand}" Style="{StaticResource SidebarNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHelp}" Fill="#0083CB" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                                <TextBlock Text="الاختصارات والتعليمات" />
                            </StackPanel>
                        </RadioButton>
                    </WrapPanel>
                </ScrollViewer>
            </Border>

            <!-- شريط الشاشات المنفصلة السريع (Multi-Window) -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#E0F2FE" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock Text="الشاشة المعروضة:" Foreground="#0369A1" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding CurrentViewTitle}" Foreground="#1E293B" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- زر فتح الشاشة الحالية في نافذة مستقلة -->
                        <Button Command="{Binding OpenCurrentInSeparateWindowCommand}"
                                Background="#0284C7" Foreground="White" BorderThickness="0"
                                Padding="12,5" Margin="0,0,8,0" Cursor="Hand"
                                ToolTip="فتح هذه الشاشة في نافذة جديدة مستقلة لشاشات العرض المتعددة">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⧉ فتح في نافذة مستقلة" FontWeight="Bold" FontSize="11" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="20" Background="#CBD5E1" Margin="4,0,8,0" />

                        <!-- أزرار مباشرة لفتح الشاشات الأساسية في نوافذ منفصلة -->
                        <TextBlock Text="شاشات مستقلة:" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />

                        <Button Command="{Binding OpenSalesInSeparateWindowCommand}"
                                Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="10,4" Margin="0,0,4,0" Cursor="Hand" ToolTip="فتح شاشة المبيعات (POS) في نافذة منفصلة">
                            <TextBlock Text="+ المبيعات" Foreground="#0083CB" FontSize="11" FontWeight="Bold" />
                        </Button>

                        <Button Command="{Binding OpenPurchasesInSeparateWindowCommand}"
                                Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="10,4" Margin="0,0,4,0" Cursor="Hand" ToolTip="فتح شاشة المشتريات والموردين في نافذة منفصلة"
                                Visibility="{Binding CanAccessPurchases, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="+ المشتريات" Foreground="#32992B" FontSize="11" FontWeight="Bold" />
                        </Button>

                        <Button Command="{Binding OpenInventoryInSeparateWindowCommand}"
                                Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="10,4" Margin="0,0,4,0" Cursor="Hand" ToolTip="فتح شاشة المخزون والأدوية في نافذة منفصلة"
                                Visibility="{Binding CanAccessInventory, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="+ المخزون" Foreground="#D3277B" FontSize="11" FontWeight="Bold" />
                        </Button>

                        <Button Command="{Binding OpenCustomersInSeparateWindowCommand}"
                                Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="10,4" Margin="0,0,4,0" Cursor="Hand" ToolTip="فتح شاشة حسابات العملاء والآجل في نافذة منفصلة"
                                Visibility="{Binding CanAccessCustomers, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="+ العملاء" Foreground="#E7387D" FontSize="11" FontWeight="Bold" />
                        </Button>

                        <Button Command="{Binding OpenReportsInSeparateWindowCommand}"
                                Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="10,4" Cursor="Hand" ToolTip="فتح شاشة التقارير والإحصاءات في نافذة منفصلة"
                                Visibility="{Binding CanAccessReports, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="+ التقارير" Foreground="#0155A5" FontSize="11" FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- منطقة عرض الشاشة الحالية -->
            <ContentControl Grid.Row="2" Content="{Binding CurrentView}" Margin="6" />
        </Grid>

        <!-- الفوتر: تحت خالص -->
        <Border Grid.Row="3" Background="White" BorderBrush="#D5E4EE" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock x:Name="FooterCredit" Text="E-Prescriptions by Maged Fayez | (C) all rights reserved" FlowDirection="LeftToRight"
                       Foreground="#5B7389" FontSize="11" HorizontalAlignment="Center" />
        </Border>
    </Grid>
</Window>
