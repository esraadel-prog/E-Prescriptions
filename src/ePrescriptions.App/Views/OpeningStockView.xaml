<UserControl x:Class="ePrescriptions.App.Views.OpeningStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFontFamily}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F4" Command="{Binding OpenItemSearchCommand}" />
        <KeyBinding Key="Delete" Command="{Binding RemoveSelectedLineCommand}" />
    </UserControl.InputBindings>

    <Grid Background="Transparent">
        <Border Background="White" CornerRadius="12" Margin="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="4" Opacity="0.12" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. رأس الشاشة والشريط العلوي -->
                <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" CornerRadius="12,12,0,0" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconOpeningStock}" Fill="#34D399" Width="26" Height="26" Stretch="Uniform" Margin="0,0,12,0" />
                            <StackPanel>
                                <TextBlock Text="رصيد أول المدة (بضاعة أول المدة)" FontSize="20" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="إدخال وحصر المخزون الافتتاحي لكافة الأصناف بالصيدلية قبل بدء التشغيل الفعلي على البرنامج" FontSize="11" Foreground="#CBD5E1" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- أزرار الإجراءات السريعة -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Click="BtnImportExcel_Click" Style="{StaticResource PosActionButton}" Background="#0284C7" Margin="0,0,8,0" Padding="12,6" ToolTip="استيراد كشف أصناف من ملف Excel جاهز">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                                    <TextBlock Text="استيراد من Excel" FontWeight="Bold" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ExportTemplateCommand}" Style="{StaticResource PosActionButton}" Background="#475569" Margin="0,0,8,0" Padding="10,6" ToolTip="تنزيل نموذج Excel فارغ لتعبئة الأصناف">
                                <TextBlock Text="نموذج Excel فارغ" />
                            </Button>

                            <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource PosActionButton}" Background="#059669" Margin="0,0,8,0" Padding="10,6" ToolTip="تصدير قائمة السند الحالية إلى Excel">
                                <TextBlock Text="تصدير Excel" />
                            </Button>

                            <Button Command="{Binding ToggleHistoryCommand}" Style="{StaticResource PosActionButton}" Background="#0369A1" Margin="0,0,8,0" Padding="10,6" ToolTip="استعراض سندات رصيد أول المدة المسجلة سابقاً">
                                <TextBlock Text="السندات السابقة" />
                            </Button>

                            <Button Command="{Binding ClearAllLinesCommand}" Style="{StaticResource PosActionButton}" Background="#DC2626" Padding="10,6" ToolTip="مسح جميع البنود والبدء من جديد">
                                <TextBlock Text="تفريغ" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. بيانات السند (رقم السند، التاريخ، الملاحظات) -->
                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="رقم السند:" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" Text="{Binding VoucherNumber, Mode=TwoWay}" Style="{StaticResource AppTextBox}" IsReadOnly="True" Background="#F1F5F9" FontWeight="Bold" TextAlignment="Center" Margin="0,0,16,0" />

                        <TextBlock Grid.Column="2" Text="تاريخ الرصيد:" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <DatePicker Grid.Column="3" SelectedDate="{Binding VoucherDate, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <TextBlock Grid.Column="4" Text="ملاحظات:" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="5" Text="{Binding Notes, Mode=TwoWay}" Style="{StaticResource AppTextBox}" />
                    </Grid>
                </Border>

                <!-- 3. لوحة الإدخال السريع بالباركود والبحث (F4) -->
                <Border Grid.Row="2" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Margin="14,10,14,6" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- الصف الأول: باركود + بحث F4 + اسم الصنف والمادة الفعالة -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>

                            <!-- مسح الباركود -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="الباركود (امسح أو اكتب واضغط Enter):" FontSize="11" FontWeight="Bold" Foreground="#047857" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtScanInput" Text="{Binding ScanOrSearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" KeyDown="TxtScanInput_KeyDown" />
                            </StackPanel>

                            <!-- زر بحث F4 -->
                            <Button Grid.Column="1" Command="{Binding OpenItemSearchCommand}" Style="{StaticResource PosActionButton}" Background="#0284C7" VerticalAlignment="Bottom" Height="36" Padding="12,0" Margin="0,0,12,0" ToolTip="بحث في دليل الأدوية (F4)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSearch}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                                    <TextBlock Text="بحث (F4)" FontWeight="Bold" />
                                </StackPanel>
                            </Button>

                            <!-- اسم الصنف العربي -->
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="اسم الصنف الدوائي (عربي): *" FontSize="11" FontWeight="Bold" Foreground="#047857" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EntryItemNameAr, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" FontWeight="Bold" />
                            </StackPanel>

                            <!-- المادة الفعالة -->
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="المادة الفعالة:" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EntryActiveIngredient, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                            </StackPanel>
                        </Grid>

                        <!-- الصف الثاني: معاملات التجزئة + التشغيلة والصلاحية + الكمية + الأسعار + زر الإضافة -->
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- أشرطة/علبة -->
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="شرائط/علبة:" FontSize="10" Foreground="#475569" Margin="0,0,0,3" />
                                <TextBox Text="{Binding EntryStripsPerBox, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" TextAlignment="Center" />
                            </StackPanel>

                            <!-- أقراص/شريط -->
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="أقراص/شريط:" FontSize="10" Foreground="#475569" Margin="0,0,0,3" />
                                <TextBox Text="{Binding EntryPiecesPerStrip, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" TextAlignment="Center" />
                            </StackPanel>

                            <!-- التشغيلة -->
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="رقم التشغيلة:" FontSize="10" Foreground="#475569" Margin="0,0,0,3" />
                                <TextBox Text="{Binding EntryBatchNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                            </StackPanel>

                            <!-- الصلاحية -->
                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="تاريخ الصلاحية:" FontSize="10" Foreground="#475569" Margin="0,0,0,3" />
                                <DatePicker SelectedDate="{Binding EntryExpiryDate, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- علب -->
                            <StackPanel Grid.Column="4" Margin="0,0,6,0">
                                <TextBlock Text="عدد العلب: *" FontSize="10" FontWeight="Bold" Foreground="#047857" Margin="0,0,0,3" />
                                <TextBox Text="{Binding EntryQuantityBoxes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" FontWeight="Bold" TextAlignment="Center" Background="#FEF08A" />
                            </StackPanel>

                            <!-- أشرطة -->
                            <StackPanel Grid.Column="5" Margin="0,0,6,0">
                                <TextBlock Text="أشرطة:" FontSize="10" Foreground="#475569" Margin="0,0,0,3" />
                                <TextBox Text="{Binding EntryQuantityStrips, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" TextAlignment="Center" />
                            </StackPanel>

                            <!-- أقراص -->
                            <StackPanel Grid.Column="6" Margin="0,0,8,0">
                                <TextBlock Text="أقراص:" FontSize="10" Foreground="#475569" Margin="0,0,0,3" />
                                <TextBox Text="{Binding EntryQuantityUnits, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" TextAlignment="Center" />
                            </StackPanel>

                            <!-- إجمالي الوحدات Preview -->
                            <StackPanel Grid.Column="7" Margin="0,0,8,0">
                                <TextBlock Text="إجمالي الوحدات:" FontSize="10" Foreground="#64748B" Margin="0,0,0,3" />
                                <Border Background="#E2E8F0" CornerRadius="6" Height="34" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EntryTotalUnitsPreview}" FontSize="11" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <!-- سعر الشراء للعلبة -->
                            <StackPanel Grid.Column="8" Margin="0,0,8,0">
                                <TextBlock Text="شراء العلبة (ج.م): *" FontSize="10" FontWeight="Bold" Foreground="#B45309" Margin="0,0,0,3" />
                                <TextBox Text="{Binding EntryCostPricePounds, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}" Style="{StaticResource AppTextBox}" FontWeight="Bold" TextAlignment="Center" />
                            </StackPanel>

                            <!-- سعر الجمهور للعلبة -->
                            <StackPanel Grid.Column="9" Margin="0,0,10,0">
                                <TextBlock Text="بيع الجمهور (ج.م): *" FontSize="10" FontWeight="Bold" Foreground="#047857" Margin="0,0,0,3" />
                                <TextBox Text="{Binding EntryRetailPricePounds, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}" Style="{StaticResource AppTextBox}" FontWeight="Bold" TextAlignment="Center" />
                            </StackPanel>

                            <!-- زر إضافة الصنف للسند -->
                            <Button Grid.Column="10" Command="{Binding AddCurrentLineCommand}" Style="{StaticResource PosActionButton}" Background="#16A34A" Height="36" Padding="16,0" VerticalAlignment="Bottom" ToolTip="إضافة الصنف للسند (Enter)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                                    <TextBlock Text="إضافة للسند" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 4. كروت المؤشرات المالية والإحصائية (KPI Badges) -->
                <Grid Grid.Row="3" Margin="14,4,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- عدد الأصناف -->
                    <Border Grid.Column="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="عدد الأصناف المسجلة" FontSize="11" Foreground="#1E40AF" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TotalItemsCount}" FontSize="18" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- إجمالي الوحدات -->
                    <Border Grid.Column="1" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="إجمالي الوحدات الصغرى" FontSize="11" Foreground="#15803D" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TotalUnitsCount, StringFormat='{}{0:N0} وحدة'}" FontSize="18" FontWeight="Bold" Foreground="#14532D" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- إجمالي التكلفة -->
                    <Border Grid.Column="2" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="إجمالي قيمة التكلفة (الشراء)" FontSize="11" Foreground="#B45309" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding FormattedTotalCost}" FontSize="18" FontWeight="Bold" Foreground="#78350F" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- إجمالي سعر الجمهور -->
                    <Border Grid.Column="3" Background="#FDF2F8" BorderBrush="#FBCFE8" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="إجمالي قيمة سعر الجمهور (البيع)" FontSize="11" Foreground="#BE185D" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding FormattedTotalRetail}" FontSize="18" FontWeight="Bold" Foreground="#831843" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- هامش الربح المتوقع -->
                    <Border Grid.Column="4" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="الربح المتوقع / الهامش" FontSize="11" Foreground="#6D28D9" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ProfitMarginPercent, StringFormat='{}{0:N1}%'}" FontSize="18" FontWeight="Bold" Foreground="#4C1D95" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 5. جدول الأصناف والبنود (DataGrid) -->
                <DataGrid Grid.Row="4"
                          ItemsSource="{Binding Lines}"
                          SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          BorderThickness="1"
                          BorderBrush="#CBD5E1"
                          Margin="14,0,14,10"
                          RowHeight="34">
                    <DataGrid.Columns>
                        <!-- الباركود -->
                        <DataGridTextColumn Header="الباركود" Binding="{Binding ItemBarcode}" Width="120" />

                        <!-- كود الصنف -->
                        <DataGridTextColumn Header="الكود" Binding="{Binding ItemCode}" Width="100" />

                        <!-- اسم الصنف الدوائي والمادة الفعالة -->
                        <DataGridTemplateColumn Header="اسم الصنف الدوائي والمادة الفعالة" Width="3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="4,2">
                                        <TextBlock Text="{Binding ItemNameAr}" FontWeight="Bold" FontSize="13" Foreground="#0B2A45" />
                                        <TextBlock Text="{Binding ActiveIngredient}" FontSize="10" Foreground="#64748B" Visibility="{Binding ActiveIngredient, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- رقم التشغيلة -->
                        <DataGridTextColumn Header="التشغيلة" Binding="{Binding BatchNumber}" Width="110" />

                        <!-- تاريخ الصلاحية -->
                        <DataGridTextColumn Header="الصلاحية" Binding="{Binding ExpiryDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="95" />

                        <!-- الكمية بالعلب والوحدات -->
                        <DataGridTextColumn Header="الكمية المفصلة" Binding="{Binding FormattedQuantity}" Width="130" />

                        <!-- إجمالي الوحدات -->
                        <DataGridTextColumn Header="إجمالي الوحدات" Binding="{Binding TotalSmallestUnits}" Width="90" FontWeight="Bold" />

                        <!-- سعر التكلفة للعلبة -->
                        <DataGridTextColumn Header="تكلفة العلبة" Binding="{Binding FormattedCostPrice}" Width="100" />

                        <!-- إجمالي التكلفة -->
                        <DataGridTextColumn Header="إجمالي التكلفة" Binding="{Binding FormattedTotalCost}" Width="110" FontWeight="Bold" />

                        <!-- سعر الجمهور للعلبة -->
                        <DataGridTextColumn Header="سعر الجمهور" Binding="{Binding FormattedRetailPrice}" Width="100" />

                        <!-- إجمالي سعر الجمهور -->
                        <DataGridTextColumn Header="إجمالي الجمهور" Binding="{Binding FormattedTotalRetail}" Width="110" FontWeight="Bold" />

                        <!-- زر حذف البند -->
                        <DataGridTemplateColumn Header="إجراء" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.RemoveSelectedLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="حذف هذا الصنف من السند">
                                        <Path Data="{StaticResource IconTrash}" Fill="#EF4444" Width="14" Height="14" Stretch="Uniform" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 6. شريط الحالة وزر الحفظ والاعتماد النهائي -->
                <Border Grid.Row="5" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="16,12" CornerRadius="0,0,12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- رسالة الحالة -->
                        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="#0B2A45" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                        <!-- زر الاعتماد والحفظ الكبير -->
                        <Button Grid.Column="1" Command="{Binding SaveAndPostCommand}" Style="{StaticResource PosActionButton}" Background="#15803D" Padding="24,10" Height="44" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSave}" Fill="White" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" />
                                <TextBlock Text="اعتماد وحفظ رصيد أول المدة في المخزون" FontSize="15" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- نافذة البحث السريع المنسدلة (F4) -->
        <Border Visibility="{Binding IsSearchPopupOpen, Converter={StaticResource BoolToVis}}"
                Background="#B0000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="White" CornerRadius="12" Width="680" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.3" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="بحث في دليل الأدوية والأصناف (F4)" FontSize="18" FontWeight="Bold" Foreground="#0B2A45" />
                        <Button Grid.Column="1" Command="{Binding CloseSearchPopupCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Path Data="{StaticResource IconClose}" Fill="#64748B" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <TextBox Grid.Row="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" FontSize="14" Margin="0,0,0,12" />

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding SearchResults}"
                              SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="DgSearchResults_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="120" />
                            <DataGridTextColumn Header="الاسم التجاري" Binding="{Binding NameAr}" Width="2*" FontWeight="Bold" />
                            <DataGridTextColumn Header="المادة الفعالة" Binding="{Binding ActiveIngredient}" Width="1.5*" />
                            <DataGridTextColumn Header="سعر البيع" Binding="{Binding RetailPriceBoxPiastres, Converter={x:Null}}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
                        <Button Command="{Binding SelectSearchResultCommand}" Style="{StaticResource PosActionButton}" Background="#0284C7" Padding="18,6" Margin="0,0,10,0">
                            <TextBlock Text="اختيار الصنف" FontWeight="Bold" />
                        </Button>
                        <Button Command="{Binding CloseSearchPopupCommand}" Style="{StaticResource PosActionButton}" Background="#64748B" Padding="14,6">
                            <TextBlock Text="إلغاء" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- درج / نافذة استعراض السندات السابقة -->
        <Border Visibility="{Binding IsHistoryOpen, Converter={StaticResource BoolToVis}}"
                Background="#B0000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="White" CornerRadius="12" Width="800" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.3" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="سجل سندات رصيد أول المدة المسجلة" FontSize="18" FontWeight="Bold" Foreground="#0B2A45" />
                        <Button Grid.Column="1" Command="{Binding ToggleHistoryCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Path Data="{StaticResource IconClose}" Fill="#64748B" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding PastVouchers}"
                              SelectedItem="{Binding SelectedPastVoucher, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="DgPastVouchers_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم السند" Binding="{Binding VoucherNumber}" Width="140" FontWeight="Bold" />
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding VoucherDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100" />
                            <DataGridTextColumn Header="عدد الأصناف" Binding="{Binding TotalItemsCount}" Width="90" />
                            <DataGridTextColumn Header="إجمالي الوحدات" Binding="{Binding TotalSmallestUnits}" Width="100" />
                            <DataGridTextColumn Header="قيمة التكلفة" Binding="{Binding FormattedTotalCost}" Width="130" FontWeight="Bold" />
                            <DataGridTextColumn Header="قيمة البيع" Binding="{Binding FormattedTotalRetail}" Width="130" FontWeight="Bold" />
                            <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
                        <Button Command="{Binding LoadSelectedPastVoucherCommand}" Style="{StaticResource PosActionButton}" Background="#0284C7" Padding="18,6" Margin="0,0,10,0">
                            <TextBlock Text="تحميل واستعراض بنود السند" FontWeight="Bold" />
                        </Button>
                        <Button Command="{Binding ToggleHistoryCommand}" Style="{StaticResource PosActionButton}" Background="#64748B" Padding="14,6">
                            <TextBlock Text="إغلاق" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
