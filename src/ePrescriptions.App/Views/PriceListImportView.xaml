<UserControl x:Class="ePrescriptions.App.Views.PriceListImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFontFamily}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- العنوان والحالة -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="تحديث الأسعار من ملف Excel" FontSize="18" FontWeight="Bold" Foreground="#0A4C86" />
                <TextBlock Text="اختار ملف قائمة أسعار المورد (.xlsx). هتشوف معاينة بالسعر القديم والجديد قبل أي تغيير، وكل تغيير بيتسجّل في سجل التدقيق. الأسعار بسعر العلبة."
                           Foreground="#64748B" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#0083CB" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- اختيار الملف والمورد والحقول -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14,10" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="اختيار ملف Excel..." Click="Browse_Click" Style="{StaticResource PosActionButton}" Padding="16,6" />
                    <TextBlock Text="{Binding FilePath}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#3F5A73" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="المورد (للتدقيق): " VerticalAlignment="Center" Foreground="#3F5A73" />
                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" MinWidth="200" />
                    <TextBlock Text="تحديث: " VerticalAlignment="Center" Foreground="#3F5A73" Margin="24,0,6,0" />
                    <CheckBox Content="سعر الجمهور" IsChecked="{Binding UpdateRetail}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <CheckBox Content="سعر الجملة" IsChecked="{Binding UpdateWholesale}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <CheckBox Content="سعر التكلفة" IsChecked="{Binding UpdateCost}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding SummaryText}" Foreground="#0A5A96" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- جدول المعاينة -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8">
            <DataGrid ItemsSource="{Binding Lines}" Style="{StaticResource AppFastDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="اعتماد" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                    <DataGridTextColumn Header="صف" Binding="{Binding RowNumber}" Width="50" IsReadOnly="True" />
                    <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="الحالة" Width="130" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{Binding StatusColor}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="التغييرات (قديم ← جديد)" Binding="{Binding ChangesText}" Width="2*" IsReadOnly="True" />
                    <DataGridTextColumn Header="ملاحظة" Binding="{Binding Note}" Width="*" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- المجاميع والاعتماد -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="16,10" Margin="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="صفوف معلّمة: " Foreground="#64748B" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedLinesCount}" FontWeight="Bold" Margin="0,0,24,0" VerticalAlignment="Center" />
                    <TextBlock Text="أسعار هتتغيّر: " Foreground="#64748B" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedChangesCount}" FontWeight="Bold" Margin="0,0,24,0" VerticalAlignment="Center" />
                    <TextBlock Text="تحتاج مراجعة: " Foreground="#64748B" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ReviewLinesCount}" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="اعتماد التحديث" Command="{Binding ApplyCommand}" Style="{StaticResource PosActionButton}" Padding="20,8" />
                    <Button Content="تعليم الآمن فقط" Command="{Binding SelectSafeCommand}" Style="{StaticResource PosSecondaryButton}" Padding="16,8" Margin="8,0,0,0" />
                    <Button Content="إلغاء التعليم" Command="{Binding ClearSelectionCommand}" Style="{StaticResource PosSecondaryButton}" Padding="16,8" Margin="8,0,0,0" />
                    <Button Content="مسح" Command="{Binding ClearCommand}" Style="{StaticResource PosSecondaryButton}" Padding="16,8" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
