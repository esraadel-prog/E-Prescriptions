<UserControl x:Class="ePrescriptions.App.Views.StocktakeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFontFamily}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- العنوان والحالة -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="الجرد بالباركود" FontSize="18" FontWeight="Bold" Foreground="#0A4C86" />
                <TextBlock Text="امسح كل علبة على الرف (باركود الصنف أو ملصق التشغيلة). كل مسح = علبة. تقدر تعدّل الكمية المعدودة يدوياً للأشرطة والأقراص السايبة. الأصناف اللي ما اتمسحتش مش بتدخل المقارنة."
                           Foreground="#64748B" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#0083CB" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- خانة المسح -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14,10" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="امسح الباركود هنا:" FontWeight="SemiBold" Foreground="#3F5A73" Margin="0,0,0,4" />
                <TextBox x:Name="ScanBox" Text="{Binding ScanInput, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="ScanBox_KeyDown" Style="{StaticResource AppTextBox}" FontSize="16" />
            </StackPanel>
        </Border>

        <!-- جدول الجرد -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8">
            <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource AppFastDataGrid}" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="90" IsReadOnly="True" />
                    <DataGridTextColumn Header="الصنف" Binding="{Binding NameAr}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="المسجّل" Binding="{Binding BookText}" Width="130" IsReadOnly="True" />
                    <DataGridTextColumn Header="المعدود (وحدة)" Binding="{Binding CountedSmallestUnits, UpdateSourceTrigger=LostFocus}" Width="110" />
                    <DataGridTextColumn Header="المعدود" Binding="{Binding CountedText}" Width="130" IsReadOnly="True" />
                    <DataGridTextColumn Header="الفرق" Binding="{Binding DifferenceText}" Width="110" IsReadOnly="True" />
                    <DataGridTemplateColumn Width="55">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="حذف" Padding="8,3"
                                        Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- المجاميع والاعتماد -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="16,10" Margin="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="عدد المسحات: " Foreground="#64748B" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ScanCount}" FontWeight="Bold" Margin="0,0,24,0" VerticalAlignment="Center" />
                    <TextBlock Text="أصناف فيها فرق: " Foreground="#64748B" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DifferenceLinesCount}" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="اعتماد الجرد وتسوية الأرصدة" Command="{Binding ApplyCommand}"
                            Style="{StaticResource PosActionButton}" Padding="20,8" />
                    <Button Content="طباعة قائمة جرد (PDF)" Command="{Binding PrintSheetCommand}"
                            Style="{StaticResource PosSecondaryButton}" Padding="16,8" Margin="8,0,0,0" />
                    <Button Content="مسح الجلسة" Command="{Binding ClearCommand}"
                            Style="{StaticResource PosSecondaryButton}" Padding="16,8" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
