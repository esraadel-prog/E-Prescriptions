<UserControl x:Class="ePrescriptions.App.Views.StaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:ePrescriptions.Domain.Enums;assembly=ePrescriptions.Domain"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFontFamily}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Border Background="White" CornerRadius="12" Margin="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="4" Opacity="0.12" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- رأس الشاشة -->
                    <RowDefinition Height="Auto" />
                    <!-- المحتوى الرئيسي -->
                    <RowDefinition Height="*" />
                    <!-- شريط الحالة -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- رأس الشاشة -->
                <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" CornerRadius="12,12,0,0" Padding="16,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconStaff}" Fill="#02ABE1" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0" />
                        <TextBlock Text="إدارة الموظفين والورديات وتسليم الصندوق والعهدة" FontSize="20" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                </Border>

                <!-- المحتوى: لوحة الوردية يميناً + قائمة الموظفين يساراً -->
                <Grid Grid.Row="1" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <!-- لوحة الوردية وإغلاق الصندوق -->
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="إدارة الوردية الحالية والصندوق النقدي" FontWeight="Bold" FontSize="16" Foreground="#0A4C86" Margin="0,0,0,14" />

                                <!-- بطاقات إحصائية تفصيلية للوردية الحالية وطرق الدفع -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- صف 1 -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,4,4">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="الرصيد الافتتاحي" FontSize="11" Foreground="#64748B" />
                                            <TextBlock Text="{Binding FormattedOpeningBalance}" FontSize="14" FontWeight="Bold" Foreground="#0B2A45" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="1" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="4,0,4,4">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="مبيعات نقداً" FontSize="11" Foreground="#64748B" />
                                            <TextBlock Text="{Binding FormattedCashSales}" FontSize="14" FontWeight="Bold" Foreground="#10B981" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="2" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="4,0,0,4">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="مبيعات شبكة / فيزا" FontSize="11" Foreground="#64748B" />
                                            <TextBlock Text="{Binding FormattedNetworkSales}" FontSize="14" FontWeight="Bold" Foreground="#0083CB" />
                                        </StackPanel>
                                    </Border>

                                    <!-- صف 2 -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,4,4,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="مبيعات آجل" FontSize="11" Foreground="#64748B" />
                                            <TextBlock Text="{Binding FormattedOnAccountSales}" FontSize="14" FontWeight="Bold" Foreground="#D97706" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="4,4,4,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="المرتجعات النقدية" FontSize="11" Foreground="#64748B" />
                                            <TextBlock Text="{Binding FormattedCashReturns}" FontSize="14" FontWeight="Bold" Foreground="#EF4444" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="2" Background="#0A4C86" CornerRadius="8" Padding="8" Margin="4,4,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="النقد المتوقع بالدرج" FontSize="11" Foreground="#38BDF8" FontWeight="Bold" />
                                            <TextBlock Text="{Binding FormattedExpectedCash}" FontSize="15" FontWeight="Bold" Foreground="White" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- إغلاق الوردية وتسليم الصندوق -->
                                <Border Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="تسليم الصندوق وإغلاق الوردية (مقارنة النقدية)" FontWeight="Bold" FontSize="15" Foreground="#92400E" Margin="0,0,0,10" />

                                        <TextBlock Text="المبلغ الفعلي المعدود في الدرج (ج.م):" Foreground="#78350F" />
                                        <TextBox Text="{Binding ActualClosingCashPounds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" FontWeight="Bold" FontSize="18" TextAlignment="Center" Margin="0,4,0,8" />

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="الفارق (الفعلي - المتوقع):" Foreground="#78350F" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding DifferenceStatusText}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Left" Foreground="{Binding DifferenceStatusColor}" />
                                        </Grid>

                                        <TextBlock Text="ملاحظات التسليم ونقل العهدة:" Foreground="#78350F" />
                                        <TextBox Text="{Binding ClosingNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Height="45" Margin="0,4,0,12" />

                                        <Button Command="{Binding CloseShiftCommand}" Style="{StaticResource PosActionButton}" Background="#D97706" Margin="0,0,0,8">
                                            <TextBlock Text="إغلاق الوردية واعتماد التسليم" FontSize="14" />
                                        </Button>

                                        <!-- أزرار طباعة وتصدير تقرير إغلاق الوردية -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Command="{Binding PrintShiftReportCommand}" Style="{StaticResource PosSecondaryButton}" Margin="0,0,4,0" Height="34">
                                                <TextBlock Text="طباعة إيصال الوردية" FontSize="12" />
                                            </Button>
                                            <Button Grid.Column="1" Command="{Binding GenerateShiftReportPdfCommand}" Style="{StaticResource PosSecondaryButton}" Margin="4,0,0,0" Height="34">
                                                <TextBlock Text="تصدير تقرير PDF" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- فتح وردية جديدة -->
                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="فتح وردية جديدة" FontWeight="Bold" FontSize="14" Foreground="#065F46" Margin="0,0,0,8" />
                                        <TextBlock Text="الرصيد الافتتاحي للصندوق (ج.م):" Foreground="#047857" />
                                        <TextBox Text="{Binding NewOpeningBalancePounds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" FontWeight="Bold" TextAlignment="Center" Margin="0,4,0,10" />
                                        <Button Command="{Binding OpenShiftCommand}" Style="{StaticResource PosActionButton}" Background="#059669">
                                            <TextBlock Text="بدء وردية جديدة" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- قائمة الموظفين وإضافة موظف -->
                    <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="دليل الموظفين وصلاحيات الدخول" FontWeight="Bold" FontSize="15" Foreground="#0A4C86" Margin="0,0,0,10" />

                            <DataGrid Grid.Row="1" ItemsSource="{Binding UsersList}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}" SelectionMode="Single" Style="{StaticResource AppFastDataGrid}" MinHeight="130" MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الاسم" Binding="{Binding FullName}" Width="*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="90" IsReadOnly="True" />
                                    <DataGridTextColumn Header="الدور" Binding="{Binding Role}" Width="80" IsReadOnly="True" />
                                    <DataGridTextColumn Header="الصلاحيات" Binding="{Binding PermissionsSummary}" Width="105" IsReadOnly="True" />
                                    <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive, Mode=OneWay}" Width="45" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- تعديل الموظف المحدد وتخصيص صلاحياته / تعطيله / إعادة تعيين كلمة مروره -->
                            <Border Grid.Row="2" Visibility="{Binding HasSelectedUser, Converter={StaticResource BoolToVis}}"
                                    Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="تعديل الموظف المحدد:" FontWeight="Bold" Foreground="#3F5A73" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Margin="0,2,0,4" />
                                        <Grid Margin="0,2,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding EditUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Margin="0,0,4,0" />
                                            <ComboBox Grid.Column="1" SelectedValue="{Binding EditRole}" SelectedValuePath="Tag" Style="{StaticResource AppComboBox}" Margin="4,0,0,0">
                                                <ComboBoxItem Content="مدير" Tag="{x:Static enums:UserRole.Admin}" />
                                                <ComboBoxItem Content="صيدلي" Tag="{x:Static enums:UserRole.Pharmacist}" />
                                                <ComboBoxItem Content="كاشير" Tag="{x:Static enums:UserRole.Cashier}" />
                                            </ComboBox>
                                        </Grid>

                                        <!-- لوحة تخصيص الصلاحيات المتقدمة للموظف -->
                                        <Border Background="#F8FAFC" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,6">
                                            <StackPanel>
                                                <CheckBox IsChecked="{Binding IsCustomPermissions}" FontWeight="Bold" Foreground="#0369A1" Margin="0,0,0,2">
                                                    <TextBlock Text="تخصيص صلاحيات خاصة لهذا الموظف (استثناء عن الدور العام)" FontSize="12" />
                                                </CheckBox>
                                                <TextBlock Text="{Binding PermissionsModeText}" FontSize="11" Foreground="#64748B" Margin="22,0,0,6" />

                                                <!-- قسم شاشات النظام -->
                                                <TextBlock Text="شاشات النظام المتاحة للموظف:" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" Margin="0,4,0,2" />
                                                <Grid Margin="0,2,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,2,0">
                                                        <CheckBox IsChecked="{Binding PermCanAccessSales}" Content="نقطة البيع والمبيعات" IsEnabled="{Binding IsCustomPermissions}" Margin="0,2" FontSize="11" />
                                                        <CheckBox IsChecked="{Binding PermCanAccessInventory}" Content="المخزون والأصناف" IsEnabled="{Binding IsCustomPermissions}" Margin="0,2" FontSize="11" />
                                                        <CheckBox IsChecked="{Binding PermCanAccessPurchases}" Content="المشتريات والموردين" IsEnabled="{Binding IsCustomPermissions}" Margin="0,2" FontSize="11" />
                                                        <CheckBox IsChecked="{Binding PermCanAccessCustomers}" Content="حسابات العملاء والديون" IsEnabled="{Binding IsCustomPermissions}" Margin="0,2" FontSize="11" />
                                                        <CheckBox IsChecked="{Binding PermCanAccessReports}" Content="التقارير والإحصائيات" IsEnabled="{Binding IsCustomPermissions}" Margin="0,2" FontSize="11" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="2,0,0,0">
                                                        <CheckBox IsChecked="{Binding PermCanAccessFinance}" Content="المالية والمصروفات" IsEnabled="{Binding IsCustomPermissions}" Margin="0,2" FontSize="11" />
                                                        <CheckBox IsChecked="{Binding PermCanAccessStaff}" Content="إدارة الموظفين والورديات" IsEnabled="{Binding IsCustomPermissions}" Margin="0,2" FontSize="11" />
                                                        <CheckBox IsChecked="{Binding PermCanAccessSettings}" Content="الإعدادات والنسخ الاحتياطي" IsEnabled="{Binding IsCustomPermissions}" Margin="0,2" FontSize="11" />
                                                        <CheckBox IsChecked="{Binding PermCanAccessPriceListImport}" Content="استيراد قوائم الأسعار" IsEnabled="{Binding IsCustomPermissions}" Margin="0,2" FontSize="11" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- قسم العمليات والرقابة -->
                                                <TextBlock Text="العمليات وسقف الرقابة:" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" Margin="0,4,0,2" />
                                                <Grid Margin="0,2,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="سقف الخصم الأقصى (%):" VerticalAlignment="Center" FontSize="11" Foreground="#334155" Margin="0,0,6,0" />
                                                    <TextBox Grid.Column="1" Text="{Binding PermMaxDiscountPercent, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustomPermissions}" Style="{StaticResource AppTextBox}" TextAlignment="Center" Height="26" FontSize="11" />
                                                </Grid>
                                                <CheckBox IsChecked="{Binding PermCanPerformReturnsWithoutApproval}" Content="إجراء مرتجع مبيعات دون طلب موافقة إدارية" IsEnabled="{Binding IsCustomPermissions}" Margin="0,2" FontSize="11" />
                                                <CheckBox IsChecked="{Binding PermCanApproveOverrides}" Content="صلاحية اعتماد وتمرير التجاوزات لباقي الموظفين" IsEnabled="{Binding IsCustomPermissions}" Margin="0,2" FontSize="11" />
                                                <CheckBox IsChecked="{Binding PermCanManageStocktake}" Content="تسجيل واعتماد تسويات الجرد المخزني" IsEnabled="{Binding IsCustomPermissions}" Margin="0,2" FontSize="11" />
                                                <CheckBox IsChecked="{Binding PermCanEditItemPrices}" Content="تعديل أسعار الشراء والبيع للأصناف" IsEnabled="{Binding IsCustomPermissions}" Margin="0,2" FontSize="11" />

                                                <!-- أزرار الصلاحيات السريعة -->
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Command="{Binding SavePermissionsCommand}" Style="{StaticResource PosSecondaryButton}" Margin="0,0,2,0" Height="28">
                                                        <TextBlock Text="حفظ الصلاحيات" FontSize="11" />
                                                    </Button>
                                                    <Button Grid.Column="1" Command="{Binding ResetPermissionsToRoleDefaultCommand}" Style="{StaticResource PosSecondaryButton}" Margin="2,0,0,0" Height="28">
                                                        <TextBlock Text="استعادة الافتراضي للدور" FontSize="11" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- أزرار حفظ وتعديل الحساب -->
                                        <Grid Margin="0,4,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Command="{Binding SaveEditCommand}" Style="{StaticResource PosActionButton}" Background="#0083CB" Margin="0,0,4,0">
                                                <TextBlock Text="حفظ كل التعديلات" />
                                            </Button>
                                            <Button Grid.Column="1" Command="{Binding ToggleActiveCommand}" Style="{StaticResource PosActionButton}" Background="#DC2626" Margin="4,0,0,0">
                                                <TextBlock Text="{Binding ToggleActiveButtonText}" />
                                            </Button>
                                        </Grid>

                                        <TextBlock Text="إعادة تعيين كلمة المرور (8 أحرف على الأقل):" Foreground="#3F5A73" Margin="0,4,0,2" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding ResetPasswordText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Margin="0,0,4,0" />
                                            <Button Grid.Column="1" Command="{Binding ResetPasswordCommand}" Style="{StaticResource PosActionButton}" Background="#D97706" Padding="12,0">
                                                <TextBlock Text="تعيين" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- استمارة موظف جديد -->
                            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                <TextBlock Text="إضافة موظف جديد:" FontWeight="Bold" Foreground="#3F5A73" Margin="0,0,0,6" />
                                
                                <TextBlock Text="الاسم بالكامل (مثال: د. محمد أحمد أو ادمن):" Foreground="#64748B" FontSize="11" Margin="0,0,0,2" />
                                <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Margin="0,0,0,4" />
                                
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="اسم المستخدم للدخول (Username):" Foreground="#64748B" FontSize="11" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="كلمة المرور للدخول:" Foreground="#64748B" FontSize="11" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="الدور / الصلاحية:" Foreground="#64748B" FontSize="11" Margin="0,0,0,2" />
                                <ComboBox SelectedValue="{Binding NewRole}" SelectedValuePath="Tag" Style="{StaticResource AppComboBox}" Margin="0,0,0,4">
                                    <ComboBoxItem Content="مدير" Tag="{x:Static enums:UserRole.Admin}" />
                                    <ComboBoxItem Content="صيدلي" Tag="{x:Static enums:UserRole.Pharmacist}" />
                                    <ComboBoxItem Content="كاشير" Tag="{x:Static enums:UserRole.Cashier}" />
                                </ComboBox>
                                <Button Command="{Binding AddUserCommand}" Style="{StaticResource PosActionButton}" Background="#0083CB" Margin="0,4,0,0">
                                    <TextBlock Text="+ حفظ الموظف" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>

                <!-- شريط الحالة -->
                <Border Grid.Row="2" Background="#0155A5" CornerRadius="0,0,12,12" Padding="14,8">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
