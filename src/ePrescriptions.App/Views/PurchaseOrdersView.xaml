<UserControl x:Class="ePrescriptions.App.Views.PurchaseOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource AppFontFamily}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="190" />
        </Grid.RowDefinitions>

        <!-- العنوان والحالة -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="أوامر الشراء" FontSize="18" FontWeight="Bold" Foreground="#0A4C86" />
                <TextBlock Text="الأصناف اللي رصيدها وصل للحد الأدنى متجمّعة بمورد آخر شراء لكل صنف، والكمية المقترحة بالعلب (العجز + ضعف الحد الأدنى). أمر الشراء مستند طلب فقط ومش بيحرّك مخزون ولا نقدية."
                           Foreground="#64748B" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#0083CB" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- المقترحات: المجموعات + أصناف المجموعة المختارة -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.6*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="4,0,4,6">
                        <TextBlock Text="أوامر شراء مقترحة (حسب المورد)" FontWeight="Bold" Foreground="#0B3556" VerticalAlignment="Center" />
                        <Button Content="تحديث" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Style="{StaticResource PosSecondaryButton}" Padding="12,5" />
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                              Style="{StaticResource AppFastDataGrid}" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المورد" Binding="{Binding SupplierName}" Width="*" />
                            <DataGridTextColumn Header="الأصناف" Binding="{Binding ItemsCount}" Width="65" />
                            <DataGridTextColumn Header="التكلفة التقديرية" Binding="{Binding EstimatedTotalText}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="أصناف الأمر المقترح" FontWeight="Bold" Foreground="#0B3556" Margin="4,0,4,6" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding SuggestionLines}" Style="{StaticResource AppFastDataGrid}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*" />
                            <DataGridTextColumn Header="الرصيد الحالي" Binding="{Binding StockText}" Width="120" />
                            <DataGridTextColumn Header="الحد الأدنى" Binding="{Binding MinStock}" Width="85" />
                            <DataGridTextColumn Header="العلب المطلوبة" Binding="{Binding OrderBoxes}" Width="100" />
                            <DataGridTextColumn Header="تكلفة تقديرية" Binding="{Binding EstimatedText}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- حفظ أمر الشراء -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="14,10" Margin="0,10,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="4" Visibility="{Binding NeedsSupplierChoice, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="المورد (الأصناف دي مالهاش مورد سابق):" FontWeight="SemiBold" Foreground="#B45309" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" Style="{StaticResource AppComboBox}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="4">
                    <TextBlock Text="ملاحظات:" FontWeight="SemiBold" Foreground="#3F5A73" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                </StackPanel>

                <Button Grid.Column="2" Content="حفظ كأمر شراء" Command="{Binding CreateOrderCommand}" VerticalAlignment="Bottom" Margin="8,0,0,4"
                        Style="{StaticResource PosActionButton}" Padding="20,8" />
            </Grid>
        </Border>

        <!-- سجل الأوامر وتفاصيل المختار -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="4,0,4,6">
                        <TextBlock Text="سجل أوامر الشراء" FontWeight="Bold" Foreground="#0B3556" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="تسجيل استلام" Command="{Binding ReceiveOrderCommand}" Style="{StaticResource PosSecondaryButton}" Padding="12,5" Margin="0,0,6,0" />
                            <Button Content="إلغاء الأمر" Command="{Binding CancelOrderCommand}" Style="{StaticResource PosSecondaryButton}" Padding="12,5" Foreground="#DC2626" />
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                              Style="{StaticResource AppFastDataGrid}" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الأمر" Binding="{Binding OrderNumber}" Width="130" />
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding DateText}" Width="130" />
                            <DataGridTextColumn Header="المورد" Binding="{Binding SupplierName}" Width="*" />
                            <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="95" />
                            <DataGridTextColumn Header="تقديري" Binding="{Binding EstimatedTotalText}" Width="100" />
                            <DataGridTextColumn Header="بواسطة" Binding="{Binding UserName}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="أصناف الأمر المختار" FontWeight="Bold" Foreground="#0B3556" Margin="4,0,4,6" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding OrderLines}" Style="{StaticResource AppFastDataGrid}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*" />
                            <DataGridTextColumn Header="العلب" Binding="{Binding Boxes}" Width="70" />
                            <DataGridTextColumn Header="تقديري" Binding="{Binding EstimatedText}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
